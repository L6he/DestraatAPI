{
    "openapi": "3.0.3",
    "info": {
        "title": "Wads API",
        "version":"1.0.0",
        "description": "Hajusrakenduste meeskonnaprojekt"
    },
    "paths": {
        "/wads": {
            "get": {
                "summary": "Päri loetelu WAD-idest",
                "responses": {
                    "200": {
                        "description":"Õnnestunud päring",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type":"object",
                                        "properties": {
                                            "id": {
                                                "type": "string",
                                                "example": "01a177d4-b30f-72a1-8d1c-ac44b029d847"
                                            },
                                            "WadName": {
                                                "type": "string",
                                                "example": "MyHouse.pk3"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}