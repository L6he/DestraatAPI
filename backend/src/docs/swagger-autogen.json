  "definitions": {
    "Wad": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "01a1da2e-742a-70c8-95a4-d93b27b117ba"
        },
        "WadName": {
          "type": "string",
          "example": "1squares.wad"
        },
        "WadDescription": {
          "type": "string",
          "example": "A one-map DOOM WAD released like 30 years ago. Slaughter map, I think?"
        },
        "ReleaseDate": {
          "type": "string",
          "example": "2026-11-14"
        },
        "ImageURL": {},
        "Downloads": {
          "type": "number",
          "example": 0
        },
        "Comments": {},
        "CategoryID": {
          "type": "string",
          "example": "099"
        },
        "createdAt": {
          "type": "string",
          "example": "2026-11-14 13:10:39"
        },
        "updatedAt": {
          "type": "string",
          "example": "2026-11-14 13:10:39"
        }
      }
    },
    "NewWad": {
      "type": "object",
      "properties": {
        "GameName": {
          "type": "string",
          "example": "1squares.wad"
        },
